# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Unstructured Transform output (parsed HOA document text) -- this repo
# is public; keep raw document content out of it. Re-fetch via the
# Unstructured Transform MCP tools or Google Drive if needed again.
/unstructured_output/

# Raw source PDFs used to seed Supabase Storage -- large binaries, not
# needed in a public repo. Re-upload via scripts/upload_source_pdfs.py
# from a local copy if this bucket ever needs re-seeding.
/scripts/source_pdfs/
